# Локальный запуск Django с PostgreSQL на хосте.
# Для Docker используйте .env.dev.example или .env.prod.example:
# внутри контейнера DB_HOST должен быть равен db.
DJANGO_ENV=development
DEBUG=1
SECRET_KEY=change-this-local-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=journal_db
DB_USER=journal_user
DB_PASSWORD=change-this-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
WAIT_FOR_DB=0

# Значения контейнера PostgreSQL должны совпадать с DB_NAME/DB_USER/DB_PASSWORD.
POSTGRES_DB=journal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=change-this-postgres-password

DATA_TOOLS_PASSWORD=change-this-data-tools-password
