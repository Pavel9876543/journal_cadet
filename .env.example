# Локальный запуск Django с SQLite.
# Для Docker с PostgreSQL используйте .env.dev.example или .env.prod.example.
DJANGO_ENV=development
DEBUG=1
SECRET_KEY=change-this-local-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Europe/Moscow

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=journal_db
WAIT_FOR_DB=0

DATA_TOOLS_PASSWORD=change-this-data-tools-password

# Ошибки выводятся в консоль и сохраняются в журнале ошибок (до 1000 записей).
ERROR_LOGGING_ENABLED=1
ERROR_LOG_MAX_RECORDS=1000
DJANGO_LOG_LEVEL=INFO
