# Safe committed defaults for local and GitHub Actions tests.
DJANGO_ENV=test
DEBUG=0
SECRET_KEY=test-only-secret-key-with-more-than-fifty-characters-2026
ALLOWED_HOSTS=testserver,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://testserver,http://localhost
TIME_ZONE=Europe/Moscow
DB_ENGINE=django.db.backends.postgresql
DB_NAME=journal_test
DB_USER=journal
DB_PASSWORD=journal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
ERROR_LOGGING_ENABLED=0
ERROR_LOG_MAX_RECORDS=1000
DJANGO_LOG_LEVEL=WARNING
